# ==============================================
# Lifeline - environment
# ==============================================
# One file for the whole repo: the web app, the premium API, the Sui service
# and every script read this root .env.
#
#   cp .env.example .env
#
# Secrets in section 4 fail *secure* when unset - the app still runs, but
# sessions die on restart and stored agent keys stay unencrypted.

# ----------------------------------------------
# 1. World - one human, one credit line
# ----------------------------------------------
NEXT_PUBLIC_WORLD_APP_ID=app_6ad9b6ef952f1c2a9a70a58e05aa9878
NEXT_PUBLIC_WORLD_RP_ID=rp_62d19ed87590c550
NEXT_PUBLIC_WORLD_ACTION=lifeline-human-verify
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
# Signs the RP context. REQUIRED for sign-in. From the World developer portal.
WORLD_RP_SIGNING_KEY=

# ----------------------------------------------
# 2. Arc - the debt ledger (chain 5042002)
# ----------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network

# Owns the facility, signs drawdowns and funds x402 payments through Circle
# Gateway. REQUIRED to move money on Arc.
PRIVATE_KEY=
LIFELINE_FUNDING_PRIVATE_KEY=

# LifelineCreditFacility for this repo, deployed at block 64053316.
LIFELINE_CREDIT_FACILITY_ADDRESS=0xd25Fd339E08aad2534dA99B3A02dEec6EC1A818f
NEXT_PUBLIC_LIFELINE_CREDIT_FACILITY_ADDRESS=0xd25Fd339E08aad2534dA99B3A02dEec6EC1A818f

# Where a browser repayment is sent, and what the server checks it against.
NEXT_PUBLIC_LIFELINE_TREASURY_ADDRESS=0x5233E4253bC38e8CF517c0768dbC8aCC886F32B3

# USDC on Arc is native, exposed as a 6-decimal ERC-20 at this precompile.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Gateway, for batched nanopayment settlement.
FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Who the x402 resources pay. Any Arc address you control. With its key here,
# `npm run withdraw:seller` sends what it earned in Gateway back to the funding
# wallet, so testnet money circulates instead of draining.
SELLER_WALLET_ADDRESS=
SELLER_PRIVATE_KEY=

# ----------------------------------------------
# 3. Sui - the Move rail
# ----------------------------------------------
# localnet (`sui start --with-faucet`), devnet, testnet or mainnet. The
# deployment is read from sui/deployments/<network>.json, written by
# `npm run sui:deploy`; the SUI_* ids below override it when set.
SUI_NETWORK=testnet
# Lifeline's operator: holds the AdminCap, sponsors agents' gas, collects what
# falls due. `suiprivkey...`. sui:deploy generates one if this is empty.
SUI_PRIVATE_KEY=
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# SUI_PACKAGE_ID=
# SUI_FACILITY_ID=
# SUI_ADMIN_CAP_ID=
# SUI_COIN_TYPE=      # e.g. Circle's testnet USDC instead of the demo dollar

# The Sui x402 feed: npm run sui:service
SUI_SERVICE_PORT=4031
SUI_SERVICE_URL=http://localhost:4031
# Who the feed pays. Defaults to the operator.
SUI_SELLER_ADDRESS=

# One parked obligation covers draws up to this, then a new one is parked.
LIFELINE_TRANCHE_CEILING=0.5

# ----------------------------------------------
# 4. Lifeline secrets - unset is safe, but degraded
# ----------------------------------------------
# Signs the session cookie. >= 32 chars. Unset: sessions die on restart.
LIFELINE_SESSION_SECRET=
# Wraps agent private keys at rest. >= 16 chars. REQUIRED before any deploy.
LIFELINE_KEYSTORE_SECRET=

# ----------------------------------------------
# 5. Credit terms
# ----------------------------------------------
LIFELINE_DEFAULT_CREDIT_CAP=0.5
LIFELINE_TERM_SECONDS=604800        # until a drawdown is due; also the Sui obligation term
LIFELINE_MAX_PER_PAYMENT=$5.00

# ----------------------------------------------
# 6. Ports and service URLs
# ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LIFELINE_APP_URL=http://localhost:3000

# Arc x402 resources: npm run premium
PREMIUM_API_PORT=4402
NEXT_PUBLIC_X402_RESOURCE_BASE=http://localhost:4402

# World mini app - only if it is a separate Developer Portal app from World ID
NEXT_PUBLIC_MINIAPP_ID=

# ----------------------------------------------
# 7. Intercepta risk screening (Arc payments)
# ----------------------------------------------
# Free sandbox key from intercepta.io/ethglobal. Without it every Arc payment
# is held and every payer refused: nothing moves unscreened.
INTERCEPTA_API_KEY=
# Auto-approve a clean counterparty up to this much a payment; above, a human decides.
INTERCEPTA_AUTO_APPROVE_USD=0.4
# A counterparty with warning signs is capped at this much a payment.
INTERCEPTA_ELEVATED_CAP_USD=0.1
# Payee of the "Unvetted feed" demo seller, and the flagged payer the e2e sends.
INTERCEPTA_DEMO_PAYTO=0x39308ae43e5dda98db5fb17d005c5c764e5a2fed
INTERCEPTA_DEMO_PAYER=

# ----------------------------------------------
# 8. Card repayment (Apple Pay, Google Pay, card) via Stripe - test mode keys
# ----------------------------------------------
# dashboard.stripe.com/test/apikeys. Without them the option is hidden.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# For the webhook (optional locally: the browser's confirmation also books it).
# stripe listen --forward-to localhost:3000/api/repay/card/webhook
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------
# 9. World ID for Agents (sandbox) - fresh approval of held payments
# ----------------------------------------------
# Register at sandbox.auth.world.org/portal (client_secret_basic). The portal
# asks for a callback: https://<your-https-host>/api/auth/world-agents/callback
# Without these, a held payment is released by the human's click as before.
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=

# ----------------------------------------------
# 10. Limits on lending (Arc)
# ----------------------------------------------
# The most out on loan across everyone, at once.
LIFELINE_POOL_CAP_USD=100
# The most newly lent across everyone in a day.
LIFELINE_DAILY_NEW_CREDIT_USD=25
# The most lent to pay any one seller in a day.
LIFELINE_SELLER_DAILY_USD=5
# New credit stops when this share of recent loans due is unpaid...
LIFELINE_BREAKER_DEFAULT_RATE=0.2
# ...once at least this many have fallen due.
LIFELINE_BREAKER_MIN_LOANS=10

# ----------------------------------------------
# 11. Deposit-backed credit and the lending pool (Arc)
# ----------------------------------------------
# From contracts/script/DeploySecured.s.sol. Unset, both features stay off.
LIFELINE_COLLATERAL_VAULT_ADDRESS=0x59B00E85d191bCC376f2593c937E260722bd10Fb
LIFELINE_LENDING_POOL_ADDRESS=0x70cF07af1Cd055ceCeE3A2efDc7d623D23EDA02A
# Deploy-time terms. LTV: how much of a deposit may be borrowed, in basis points.
LIFELINE_COLLATERAL_LTV_BPS=8000
LIFELINE_COLLATERAL_WITHDRAW_DELAY=3600
LIFELINE_POOL_MAX_UTILIZATION_BPS=8000
LIFELINE_POOL_EXPOSURE_CAP=100000000

# ---------------------------------------------------------------- Uniswap Token Jar (Base)
# Repaying in any token. Off until both addresses are set. See docs/mumbai/uniswap.md.
LIFELINE_JAR_ADDRESS=
LIFELINE_JAR_RELEASER_ADDRESS=
BASE_RPC_URL=https://mainnet.base.org
# Clears the jar. Needs ETH and USDC on Base. Defaults to PRIVATE_KEY.
LIFELINE_JAR_KEEPER_KEY=
LIFELINE_JAR_HAIRCUT_BPS=300
LIFELINE_JAR_MAX_PER_REPAYMENT_USD=5
LIFELINE_JAR_MIN_PROFIT_USD=0.05
LIFELINE_JAR_SLIPPAGE_BPS=100

# ---------------------------------------------------------------- testing only
# 1 switches World ID off: anyone gets a test account, and holds are approved with a click.
# Testnet only. Unset it and redeploy to bring World ID back.
NEXT_PUBLIC_BYPASS_WORLD_ID=
